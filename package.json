{
  "name": "leanscope-agent-kit-angular-quickstart",
  "version": "0.11.1",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/run-ng.mjs serve --open",
    "demo:wahlplakate": "node scripts/run-ng.mjs serve --open --demo wahlplakate",
    "build": "node scripts/run-ng.mjs build",
    "watch": "node scripts/run-ng.mjs build --watch --configuration development",
    "test": "node scripts/check-brand.mjs && node scripts/run-ng.mjs test",
    "check:brand": "node scripts/check-brand.mjs",
    "publish:transcript": "node scripts/publish-transcript.mjs",
    "connect:claude": "node scripts/sync-env.mjs --claude",
    "check:token": "node scripts/check-token.mjs",
    "update:plugin": "node scripts/update-plugin.mjs",
    "inspect:mcp": "npx -y @modelcontextprotocol/inspector@latest"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "marked": "^18.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vis-data": "^8.0.6",
    "vis-timeline": "^8.5.6",
    "webvtt-parser": "^2.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@types/webvtt-parser": "^2.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
