# Your values for the app. Copy this file to `.env` (gitignored) and fill them in.
#
# The app needs NO secret. Its user signs in with their LeanScope account, and the agent server
# runs the session on its own LLM keys when that user reaches the repository. Everything in the
# first part of this file ends up in the browser bundle, and that is fine: none of it is secret.
# On Netlify, set the same names as environment variables (see netlify.toml).
#
# Coding agents: never open, print or edit `.env`.

# Required. The `_guid` of the choreo (a LeanScope Scenario) the app runs. It depends on your
# repository, so it lives here. Your coding agent tells you which one to use.
LEANSCOPE_CHOREO_SCENARIO_GUID=

# Required. The id of the repository your choreos live in (a number). A login names no repository,
# so the app sends this one. The signed-in user must be a member of it.
LEANSCOPE_REPOSITORY_ID=

# Required. The LeanScope login (Supabase): project URL and anon key. Both are public values,
# the same ones https://app.leanscope.ai/ ships to every browser.
LEANSCOPE_SUPABASE_URL=
LEANSCOPE_SUPABASE_ANON_KEY=


# App settings brand. Not secrets,
# but they depend on your repository. Your coding agent tells you which values to use.
#   APP_BRAND: brand pack under public/brands/ (default, mindline, centigrade)
#   APP_INGEST_CHOREO_GUID: the `_guid` of the "📥 Studienunterlagen einlesen" choreo.
#   APP_STUDY_QUERY_GUID: the `_guid` of the published ❓ query "Studie der Choreo".
# Both are optional: without them the discussion runs, with the participants taken from the
# session, but there is no guide, no stimuli and no reading in of documents.
APP_BRAND=default
APP_INGEST_CHOREO_GUID=
APP_STUDY_QUERY_GUID=

# Optional: the `_guid` of a carrier choreo in the repository of the recordings you show (any
# choreo with `autoTransition = false`). With it, the red Play
# button speaks a recording with the personas' voices: see "Player choreo" in README.md.
APP_PLAYER_CHOREO_GUID=

# Optional: the `_guid` of the analysis choreo. With it, the "Analyse" tab answers questions about
# the study (guide, stimuli, personas, transcripts) with a chart. It reads the repository through
# its MCP server and runs on Claude.
APP_ANALYSIS_CHOREO_GUID=

# Optional: another LeanScope Agent Server than the one in src/environments/environment.ts,
# e.g. http://localhost:3000 to try a local one.
LEANSCOPE_AGENT_SERVER_URL=

# Demos: `npm run demo <name>` lays demos/<name>/.env (same names as here) over this file and
# opens that demo. See demos/README.md.


# ---------------------------------------------------------------------------------------------
# Only for your coding agent. Optional. These are SECRETS, and they never reach the app:
# `npm run connect:claude` stores them in the LeanScope Agent Kit plugin in Claude Code (your OS
# keychain), so its MCP servers can model and test-run choreos. Leave them out if your agent
# reaches LeanScope another way. Never set them on a build server.
# ---------------------------------------------------------------------------------------------

# Your personal team-repos access token: https://app.leanscope.ai/ → avatar (top-right).
LEANSCOPE_PERSONAL_TEAM_REPOS_ACCESS_TOKEN=

# LLM keys for the agent's own test runs (`run-a-choreo`), voice and 🎯 Decision Model steps.
LEANSCOPE_OPENAI_API_KEY=
LEANSCOPE_ANTHROPIC_API_KEY=
LEANSCOPE_GOOGLE_API_KEY=
LEANSCOPE_MISTRAL_API_KEY=
LEANSCOPE_ELEVENLABS_API_KEY=
LEANSCOPE_TYPESAFE_API_KEY=
